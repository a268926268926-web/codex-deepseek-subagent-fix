# Minimal Codex-side example for the local V2 relay.
# Replace the loopback port with the URL printed by the launcher.

model_provider = "custom"
model = "gpt-6.1-sol"
model_catalog_json = "/absolute/private/bundle/routed-models.json"

[model_providers.custom]
name = "CC Switch"
base_url = "http://127.0.0.1:REPLACE_WITH_RELAY_PORT"
wire_api = "responses"

[features]
code_mode_host = true
multi_agent = true

[features.multi_agent_v2]
enabled = true
hide_spawn_agent_metadata = false
expose_spawn_agent_model_overrides = true
wait_agent_enabled = true
