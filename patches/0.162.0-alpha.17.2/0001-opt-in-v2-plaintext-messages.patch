diff --git a/codex-rs/core/src/agent/plaintext.rs b/codex-rs/core/src/agent/plaintext.rs
new file mode 100644
index 0000000..aac09d4
--- /dev/null
+++ b/codex-rs/core/src/agent/plaintext.rs
@@ -0,0 +1,328 @@
+//! Explicit compatibility mode for providers that cannot consume agent-message items.
+//!
+//! This is process-scoped and disabled unless the launcher opts in. It never decrypts content
+//! and rewrites only the outbound request copy; persisted conversation history stays intact.
+
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::models::AgentMessageInputContent;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use serde::Deserialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::HashMap;
+use std::path::Path;
+
+const MAX_RECOVERY_MAP_BYTES: usize = 4 * 1024 * 1024;
+
+/// User-owned task text recovered through a compatible service. This is not a local decryptor.
+#[derive(Deserialize)]
+struct RecoveryMap {
+    version: u8,
+    messages: HashMap<String, String>,
+}
+
+fn decode_recovery_map(bytes: &[u8]) -> Result<RecoveryMap> {
+    if bytes.len() > MAX_RECOVERY_MAP_BYTES {
+        return Err(CodexErr::InvalidRequest(
+            "V2 recovery map exceeds 4 MiB".into(),
+        ));
+    }
+    let map: RecoveryMap = serde_json::from_slice(bytes)
+        .map_err(|_| CodexErr::InvalidRequest("Invalid V2 recovery map JSON".into()))?;
+    if map.version != 1
+        || map.messages.iter().any(|(hash, text)| {
+            hash.len() != 64
+                || !hash
+                    .bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                || text.trim().is_empty()
+                || reject_ciphertext(text).is_err()
+        })
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Invalid V2 recovery map entry or version".into(),
+        ));
+    }
+    Ok(map)
+}
+
+fn load_recovery_map() -> Result<Option<RecoveryMap>> {
+    let Some(path) = std::env::var_os("CODEX_V2_RECOVERY_MAP") else {
+        return Ok(None);
+    };
+    let path = Path::new(&path);
+    if !path.is_absolute() {
+        return Err(CodexErr::InvalidRequest(
+            "V2 recovery map path must be absolute".into(),
+        ));
+    }
+    let file = std::fs::File::open(path)
+        .map_err(|_| CodexErr::InvalidRequest("Cannot read V2 recovery map".into()))?;
+    let mut bytes = Vec::new();
+    // Bound the read even when the file grows or is replaced after it was opened.
+    std::io::Read::read_to_end(
+        &mut std::io::Read::take(file, (MAX_RECOVERY_MAP_BYTES + 1) as u64),
+        &mut bytes,
+    )
+    .map_err(|_| CodexErr::InvalidRequest("Cannot read V2 recovery map".into()))?;
+    decode_recovery_map(&bytes).map(Some)
+}
+
+pub(crate) fn enabled() -> bool {
+    std::env::var("CODEX_V2_PLAINTEXT_MESSAGES").as_deref() == Ok("1")
+}
+
+pub(crate) fn reject_ciphertext(message: &str) -> std::result::Result<(), String> {
+    if message.trim_start().starts_with("gAAAAA") {
+        Err("V2 plaintext delivery received an encrypted task. Start a fresh turn with the patched runtime; ciphertext cannot be converted to plaintext locally.".to_string())
+    } else {
+        Ok(())
+    }
+}
+
+pub(crate) fn reject_encrypted_parameters(
+    parameters: Option<&[String]>,
+) -> std::result::Result<(), String> {
+    if parameters.is_some_and(|parameters| !parameters.is_empty()) {
+        Err("V2 plaintext delivery received encrypted tool parameters. No task was dispatched; request plaintext arguments in a fresh turn.".to_string())
+    } else {
+        Ok(())
+    }
+}
+
+pub(crate) fn format_request(input: &mut [ResponseItem]) -> Result<()> {
+    let recovery = load_recovery_map()?;
+    format_request_with_recovery(input, recovery.as_ref())
+}
+
+fn format_request_with_recovery(
+    input: &mut [ResponseItem],
+    recovery: Option<&RecoveryMap>,
+) -> Result<()> {
+    // Validate every conversion before applying any, so a missing recovery cannot partly rewrite
+    // an otherwise unchanged request. Persisted history is never passed here for mutation.
+    let mut conversions = Vec::new();
+    for (index, item) in input.iter().enumerate() {
+        let ResponseItem::AgentMessage { id, content, .. } = item else {
+            continue;
+        };
+        let mut text_parts = Vec::with_capacity(content.len());
+        for part in content {
+            match part {
+                AgentMessageInputContent::InputText { text } => text_parts.push(text.as_str()),
+                AgentMessageInputContent::EncryptedContent { encrypted_content } => {
+                    let hash = format!("{:x}", Sha256::digest(encrypted_content.as_bytes()));
+                    let text = recovery.and_then(|map| map.messages.get(&hash)).ok_or_else(|| {
+                        CodexErr::InvalidRequest(
+                            "An encrypted V2 task needs a verified recovery entry. Recover the task through its original compatible service and set CODEX_V2_RECOVERY_MAP; saved history remains unchanged.".into(),
+                        )
+                    })?;
+                    text_parts.push(text.as_str());
+                }
+            }
+        }
+        let text = text_parts.join("\n");
+        if text.trim().is_empty() {
+            return Err(CodexErr::InvalidRequest(
+                "V2 plaintext delivery received an empty agent message".into(),
+            ));
+        }
+        // The existing V2 renderer has already included sender, recipient, and message type.
+        conversions.push((
+            index,
+            ResponseItem::Message {
+                id: id.clone(),
+                role: "user".to_string(),
+                content: vec![ContentItem::InputText { text }],
+                phase: None,
+                internal_chat_message_metadata_passthrough: None,
+            },
+        ));
+    }
+    for (index, converted) in conversions {
+        input[index] = converted;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::AgentPath;
+    use codex_protocol::ResponseItemId;
+    use codex_protocol::protocol::InterAgentCommunication;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn plaintext_request_preserves_attribution_and_result_delivery() {
+        let text = "Message Type: FINAL_ANSWER\nTask name: /root\nSender: /root/worker\nPayload:\nverified result";
+        let mut communication = InterAgentCommunication::new(
+            AgentPath::try_from("/root/worker").unwrap(),
+            AgentPath::root(),
+            Vec::new(),
+            text.to_string(),
+            false,
+        );
+        let id = ResponseItemId::from_server("amsg-preserved-id".to_string());
+        communication.id = Some(id.clone());
+        let ordinary = ResponseItem::Message {
+            id: None,
+            role: "user".to_string(),
+            content: vec![ContentItem::InputText {
+                text: "ordinary user message".to_string(),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        };
+        let reasoning = ResponseItem::Reasoning {
+            id: None,
+            summary: Vec::new(),
+            content: None,
+            encrypted_content: Some("original-provider-reasoning".to_string()),
+            internal_chat_message_metadata_passthrough: None,
+        };
+        let mut input = vec![
+            ordinary.clone(),
+            communication.to_model_input_item(),
+            reasoning.clone(),
+        ];
+        format_request_with_recovery(&mut input, None).unwrap();
+        assert_eq!(input[0], ordinary);
+        let ResponseItem::Message {
+            id: converted_id,
+            role,
+            content,
+            ..
+        } = &input[1]
+        else {
+            panic!("expected user message")
+        };
+        assert_eq!(role, "user");
+        assert_eq!(converted_id.as_ref(), Some(&id));
+        assert_eq!(input[2], reasoning);
+        assert_eq!(
+            content,
+            &vec![ContentItem::InputText {
+                text: text.to_string()
+            }]
+        );
+        assert!(matches!(
+            communication.to_model_input_item(),
+            ResponseItem::AgentMessage { .. }
+        ));
+    }
+
+    #[test]
+    fn encrypted_history_is_rejected_without_exposing_ciphertext() {
+        let communication = InterAgentCommunication::new_encrypted(
+            AgentPath::root(),
+            AgentPath::try_from("/root/worker").unwrap(),
+            Vec::new(),
+            "private-ciphertext".to_string(),
+            true,
+        );
+        let mut input = vec![communication.to_model_input_item()];
+        let error = format_request_with_recovery(&mut input, None)
+            .unwrap_err()
+            .to_string();
+        assert!(!error.contains("private-ciphertext"));
+        assert!(matches!(input[0], ResponseItem::AgentMessage { .. }));
+    }
+
+    #[test]
+    fn encrypted_tool_argument_cannot_be_relabelled_as_plaintext() {
+        assert!(reject_ciphertext("  gAAAAABencrypted-value").is_err());
+        assert!(reject_ciphertext("Read the fixture and return PONG").is_ok());
+        assert!(reject_encrypted_parameters(Some(&["message".to_string()])).is_err());
+        assert!(reject_encrypted_parameters(Some(&[])).is_ok());
+        assert!(reject_encrypted_parameters(None).is_ok());
+    }
+
+    #[test]
+    fn recovered_old_task_preserves_envelope_id_and_saved_ciphertext() {
+        let mut communication = InterAgentCommunication::new_encrypted(
+            AgentPath::root(),
+            AgentPath::try_from("/root/worker").unwrap(),
+            Vec::new(),
+            "old-private-ciphertext".into(),
+            true,
+        );
+        let id = ResponseItemId::from_server("amsg-old-task-id".into());
+        communication.id = Some(id.clone());
+        let original = communication.to_model_input_item();
+        let map = RecoveryMap {
+            version: 1,
+            messages: HashMap::from([(
+                format!("{:x}", Sha256::digest(b"old-private-ciphertext")),
+                "Read the fixture; return OLD_TASK_OK".into(),
+            )]),
+        };
+        let mut input = vec![original.clone()];
+        format_request_with_recovery(&mut input, Some(&map)).unwrap();
+        let ResponseItem::Message {
+            id: restored_id,
+            content,
+            ..
+        } = &input[0]
+        else {
+            panic!("expected recovered message")
+        };
+        assert_eq!(restored_id.as_ref(), Some(&id));
+        let ContentItem::InputText { text } = &content[0] else {
+            panic!("expected text")
+        };
+        assert!(text.contains("/root/worker"));
+        assert!(text.contains("Read the fixture; return OLD_TASK_OK"));
+        assert!(!text.contains("old-private-ciphertext"));
+        assert_eq!(communication.to_model_input_item(), original);
+    }
+
+    #[test]
+    fn unmatched_recovery_leaves_entire_request_unchanged() {
+        let clear = InterAgentCommunication::new(
+            AgentPath::root(),
+            AgentPath::root(),
+            Vec::new(),
+            "clear task".into(),
+            false,
+        );
+        let encrypted = InterAgentCommunication::new_encrypted(
+            AgentPath::root(),
+            AgentPath::root(),
+            Vec::new(),
+            "unknown-cipher".into(),
+            true,
+        );
+        let mut input = vec![clear.to_model_input_item(), encrypted.to_model_input_item()];
+        let original = input.clone();
+        let map = RecoveryMap {
+            version: 1,
+            messages: HashMap::new(),
+        };
+        let error = format_request_with_recovery(&mut input, Some(&map))
+            .unwrap_err()
+            .to_string();
+        assert_eq!(input, original);
+        assert!(!error.contains("unknown-cipher"));
+    }
+
+    #[test]
+    fn malformed_recovery_never_exposes_private_task_text() {
+        for value in [
+            serde_json::json!({"version":2,"messages":{}}),
+            serde_json::json!({"version":1,"messages":{"wrong-hash":"private task"}}),
+            serde_json::json!({"version":1,"messages":{"a".repeat(64):"gAAAAABcipher"}}),
+            serde_json::json!({"version":1,"messages":{"a".repeat(64):"   "}}),
+        ] {
+            let error = decode_recovery_map(&serde_json::to_vec(&value).unwrap())
+                .err()
+                .unwrap()
+                .to_string();
+            assert!(!error.contains("private task"));
+            assert!(!error.contains("gAAAAABcipher"));
+        }
+        assert!(decode_recovery_map(&vec![b' '; MAX_RECOVERY_MAP_BYTES + 1]).is_err());
+    }
+}
